# ============================================================================
#  MODÈLE de secrets Supabase — NE JAMAIS COMMITER DE VALEURS RÉELLES.
#  Copiez ce fichier en `supabase/.env`, remplissez-le, puis :
#      supabase secrets set --env-file ./supabase/.env
#  `supabase/.env` est ignoré par Git.
# ============================================================================

# --- Site -------------------------------------------------------------------
SITE_URL=https://e-booklive.offboard-hub.com
WHATSAPP_AIDE_NUMBER=22670123456
SUPPORT_EMAIL=contact@e-booklive.offboard-hub.com

# --- SasPay (23 pays, devise locale) ----------------------------------------
SASPAY_API_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
SASPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx
# SASPAY_BASE_URL=https://api.saspay.me/api/v1
# SASPAY_PAYMENT_LINK=https://app.saspay.me/pay/xxxxxxxx

# --- Paddle (paiement international : tous les pays hors SasPay) ------------
# Base API : https://api.paddle.com (production)
#            https://sandbox-api.paddle.com (sandbox)
PADDLE_API_KEY=pdl_sdbx_xxxxxxxxxxxxxxxxxxxxxxxxx
PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxxxxxxx
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxxxxxxxxxxxxxxxxxxx
# sandbox ou production (nom historique français ; PADDLE_ENVIRONMENT accepté aussi)
PADDLE_ENVIRONNEMENT=sandbox
# Alias accepté pour le jeton public si PADDLE_CLIENT_TOKEN est absent :
# PADDLE_TOKEN_KIT=test_xxxxxxxxxxxxxxxxxxxxxxxxx

# Price IDs Paddle — base USD (tous les pays Paddle, USD par défaut)
PADDLE_PRICE_KIT_PROMPT=pri_xxxxxxxxxxxxxxxxxxxxxxxxx
PADDLE_PRICE_KIT_SHEET=pri_xxxxxxxxxxxxxxxxxxxxxxxxx
PADDLE_PRICE_KIT_LIVRE=pri_xxxxxxxxxxxxxxxxxxxxxxxxx
PADDLE_PRICE_KIT_PACK=pri_xxxxxxxxxxxxxxxxxxxxxxxxx
PADDLE_PRICE_STUDIO=pri_xxxxxxxxxxxxxxxxxxxxxxxxx

# --- Studio Live -------------------------------------------------------------
# Aucun secret dédié : le Studio Live réutilise SITE_URL, DEEPSEEK_API_KEY,
# GEMINI_API_KEY, RESEND_API_KEY et RESEND_FROM_EMAIL.
# Prix de référence : 10 USD / 30 jours (converti par le serveur).
# Le price ID Paddle du Studio est PADDLE_PRICE_STUDIO.

# --- Resend (emails : accueil + livraison des kits) -------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=e-booklive <bonjour@votre-domaine.com>

# --- Intelligence artificielle ---------------------------------------------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-2.5-flash

# --- Google Sheets (JSON du compte de service, sur une seule ligne) --------
GOOGLE_WORKSPACE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# --- Administrateurs --------------------------------------------------------
ADMIN_EMAILS=votre-email@exemple.com

# --- YouTube (robot live + distribution vidéo) -----------------------------
YOUTUBE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx
YOUTUBE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
# YOUTUBE_LIVE_VIDEO_ID=xxxxxxxxxxx
# YOUTUBE_LIVE_CHAT_ID=Cgxxxxxxxxxxxxxxxx

# --- TikTok (Content Posting API, brouillon) -------------------------------
# La connexion se fait depuis /admin-videos → « Connecter TikTok ».
TIKTOK_CLIENT_KEY=awxxxxxxxxxxxxxxxx
TIKTOK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# URL de retour OAuth à déclarer chez TikTok (défaut : $SITE_URL/)
# TIKTOK_REDIRECT_URI=https://votre-domaine.com/
# TIKTOK_SCOPES=video.upload
# Secours optionnel si vous préférez un refresh token manuel :
# TIKTOK_REFRESH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Divers ----------------------------------------------------------------
CRON_SECRET=une-chaine-aleatoire-tres-longue
MAX_VIDEO_MB=90

# SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont injectés
# automatiquement par Supabase : ne les définissez pas ici.
